class Solution {
public:
    vector<int> shuffle(vector<int>& nums, int n) {
      vector<int>ans;

      int start=0;
      int end=n;
      for(int i=0;i<n;i++){
        ans.push_back(nums[start]);
        ans.push_back(nums[end]);
        start++;
        end++;
      } 
      return ans;
    }
};
