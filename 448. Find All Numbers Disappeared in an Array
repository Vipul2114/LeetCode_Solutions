class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        vector<int> ans;
        map<int, int> m;

        for(int i = 0; i < nums.size(); i++) {
            m[nums[i]]++;
        }

        for(int j = 1; j <= nums.size(); j++) {
            if(m.find(j) == m.end()) {
                ans.push_back(j);
            }
        }

        return ans;
    }
};
