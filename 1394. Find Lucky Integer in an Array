
class Solution {
public:
    int findLucky(vector<int>& arr) {
        map<int, int> m;
        int count = -1;

        for (int i = 0; i < arr.size(); i++) {
            m[arr[i]]++;
        }

        for (auto it = m.begin(); it != m.end(); it++) {
            if (it->first == it->second) {
                count = max(count, it->first);
            }
        }

        return count;
    }
};
