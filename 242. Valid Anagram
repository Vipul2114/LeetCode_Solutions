class Solution
{
public:
    bool isAnagram(string s, string t)
    {
        map<char, int> mp;
        for (int i = 0; i < s.size(); i++)
        {
            mp[s[i]]++;
        }
        map<char, int> m;
        for (int j = 0; j < t.size(); j++)
        {
            m[t[j]]++;
        }
        if (mp == m)
        {
            return true;
        }
        return false;
    }
};
