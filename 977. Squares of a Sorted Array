class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
       
        int ans=0;
        vector<int>result;
       
       for(int i=0;i<nums.size();i++){
int ans=nums[i]*nums[i];
result.push_back(ans);

       } 
         sort(result.begin(),result.end());
       return result;
    }
};
