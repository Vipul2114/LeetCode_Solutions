class Solution {
public:
    bool uniqueOccurrences(vector<int>& arr) {

        map<int, int> m;

        
        for(int i = 0; i < arr.size(); i++) {
            m[arr[i]]++;
        }

        
        map<int, int> freq;

        for(auto it = m.begin(); it != m.end(); it++) {

            freq[it->second]++;

            if(freq[it->second] > 1) {
                return false;
            }
        }

        return true;
    }
};
