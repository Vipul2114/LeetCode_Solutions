class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        map<char,int>m1;
        map<char,int>m2;
        for(int i=0;i<ransomNote.size();i++){
            m1[ransomNote[i]]++;
        }
        for(int j=0;j<magazine.size();j++){
            m2[magazine[j]]++;
        }
          for(auto it = m1.begin(); it != m1.end(); it++) {
            if(it->second > m2[it->first]) {
                return false;
            }
          }
        return true;
    }
};
